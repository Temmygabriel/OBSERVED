{
  "name": "observed",
  "version": "0.1.0",
  "private": true,
  "description": "A reviewer agent that is not allowed to have an opinion until it has paid for evidence.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
