# =============================================================================
# Observed — environment template
#
# Copy to `.env` for local work. NEVER commit a real `.env` (Rule 11).
# In production these are read from the hosting platform's secret store
# (Vercel project settings for apps/web, Railway/Render env for apps/worker).
# =============================================================================

# --- apps/web -----------------------------------------------------------------
# Public read API of the worker. Leave EMPTY to run the site in its honest
# empty state (it will show "Nothing has been checked yet." and offer a
# clearly-labelled sample review). It will never invent numbers to fill space.
NEXT_PUBLIC_OBSERVED_API_URL=

# --- AskBots ------------------------------------------------------------------
# Get this from https://www.askbots.ai — fetch https://www.askbots.ai/skill.md
# first, it is the stated source of truth for the current base URL.
ASKBOTS_API_KEY=
ASKBOTS_BASE_URL=https://www.askbots.ai/api

# --- Celo / RPC ---------------------------------------------------------------
CELO_RPC_URL=
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# --- buy / x402 ---------------------------------------------------------------
# Platform secret store only. Never logged, never passed to the Review Generator.
BUY_WALLET_PRIVATE_KEY=
BUY_MCP_ENDPOINT=

# --- ERC-8004 / attribution ---------------------------------------------------
ERC8004_AGENT_ID=
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
# Assigned at registration. Must be embedded in calldata from the FIRST
# mainnet transaction via toDataSuffix() — there is no backfill (Rule 8).
ATTRIBUTION_TAG=

# --- Policy (Rule 9) ----------------------------------------------------------
# PAYMENTS_ENABLED=false must make the Payment Worker fail CLOSED.
PAYMENTS_ENABLED=true
SPEND_CAP_HOURLY=0.25
SPEND_CAP_DAILY=1.00
SPEND_CAP_PER_REVIEW=0.03
SPEND_CAP_PER_PROVIDER_REQUEST=0.01
MAX_PAID_CALLS_PER_PROVIDER_PER_REVIEW=3
# JSON array of ExclusionListEntry — Rule 5. Checked BEFORE any money is spent.
EXCLUSION_LIST=[]

# --- Watchdog (Rule 12) -------------------------------------------------------
# Alerts on BUSINESS inactivity, not process liveness.
INACTIVITY_ALERT_MINUTES=60

# --- Worker storage -----------------------------------------------------------
# All four are git-ignored. The ledger and the evidence store are append-only;
# the raw artifacts directory is the only place attacker-supplied bytes land,
# and nothing in it is ever shown to the Review Generator.
AUDIT_LEDGER_PATH=./ledger/audit.jsonl
SPEND_LEDGER_PATH=./ledger/spend.jsonl
EVIDENCE_STORE_PATH=./data/evidence.jsonl
RAW_ARTIFACT_DIR=./raw-artifacts

# --- Optional -----------------------------------------------------------------
CENCORI_API_KEY=

NODE_ENV=development
PORT=3000
